            "body": {
              "mode": "raw",
              "raw": "{\n  \"userIds\": [\n    1,\n    2,\n    3\n  ],\n  \"emails\": [\n    \"{{userEmail}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Starts the Spring Batch job asynchronously and returns 202 with a requestId. For every user: GET user-service -> POST order-service (sample order) -> POST payment-service (matching payment). Poll the status request until status is COMPLETED, COMPLETED_WITH_ERRORS or FAILED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('propagationRequestId', pm.response.json().requestId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get propagation status (poll)",
