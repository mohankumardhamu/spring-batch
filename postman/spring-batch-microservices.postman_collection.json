    {
      "name": "4. User Generator - Virtual Threads (8081)",
      "item": [
        {
          "name": "Generate N users (virtual threads)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/generate",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 1000,\n  \"emailPrefix\": \"load\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates `count` (1..10,000,000) random users. They are split into chunks of 10,000; each chunk runs on its own virtual thread and is inserted in one transaction with JDBC batch inserts. Emails are <emailPrefix>.<random-tag>.<n>@example.com, so repeated calls never collide."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('All users created', () => pm.expect(r.created).to.eql(r.requested));",
                  "console.log(`Created ${r.created} users in ${r.durationMs} ms`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate 10 million users (virtual threads)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userServiceUrl}}/api/users/generate",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "users",
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 10000000,\n  \"emailPrefix\": \"bulk\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Bulk-loads 10 million users (about 30 s, about 2.2 GB in Postgres). Not run by the Collection Runner flow by default; send it manually. Postman waits with no timeout by default."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('All users created', () => pm.expect(r.created).to.eql(r.requested));",
                  "console.log(`Created ${r.created} users in ${r.durationMs} ms (${r.rowsPerSecond} rows/s)`);"
                ]
              }
            }
          ]
        }
