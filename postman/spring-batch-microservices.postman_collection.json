      "name": "5. Propagation - Spring Batch (8084)",
      "item": [
        {
          "name": "Propagate users (start batch job)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
