{
  "info": {
    "name": "Spring Batch Microservices",
    "_postman_id": "5b8f8c63-2f7e-4f5e-9d1a-6a1d0f6b3c21",
    "description": "User, Order, Payment CRUD services, virtual-thread user generator and Spring Batch propagation. Each service also has a GET .../count endpoint. Start the stack with `docker compose up -d --build`, then run folders top to bottom (each Create request saves its id into a collection variable used by later requests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
